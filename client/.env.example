# Base URL of the backend API. Leave empty when the server also serves this app
# (single origin) — that is the more secure setup, because auth stays in an
# httpOnly cookie. Set it when the frontend is hosted separately (e.g. Vercel
# frontend + Render backend), in which case a Bearer token is used instead.
# Must be set at BUILD time: Vite inlines it into the bundle.
VITE_API_URL=
