# --- Server ---
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
# Set to true when serving over HTTPS
COOKIE_SECURE=false
# SQLite file location (defaults to ./data/chess.db)
# DB_FILE=./data/chess.db

# --- Groq (natural-language coaching; never sent to the browser) ---
# If a configured model is retired, the server picks the best available one at
# startup (see server/src/services/llm.js) and logs the substitution.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# Model used for fast in-game hint explanations (defaults to the fallback model)
GROQ_HINT_MODEL=openai/gpt-oss-20b

# --- Stockfish ---
# Optional path to a native Stockfish binary (much faster than the bundled WASM build)
# STOCKFISH_PATH=/opt/homebrew/bin/stockfish
# Bundled WASM variant when STOCKFISH_PATH is unset: lite | full | single | lite-single
STOCKFISH_VARIANT=lite
STOCKFISH_THREADS=1
STOCKFISH_HASH_MB=64
STOCKFISH_POOL_SIZE=2
ANALYSIS_DEPTH=16
ANALYSIS_MOVETIME_MS=900
HINT_DEPTH=18
HINT_MOVETIME_MS=1200
MULTI_PV=3

# --- Live coaching ---
# Comma-separated list of accounts allowed to see live move suggestions during games
COACH_ACCOUNTS=garvitsharma1994@gmail.com

# --- Hosted database (only needed when the host has no persistent disk) ---
# Leave empty to use a local SQLite file at ./data/chess.db.
# With Turso: libsql://<database>-<org>.turso.io plus the database token.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Split-origin deploys (frontend and API on different sites) ---
# Comma-separated list of browser origins allowed to call the API.
# A leading "*." wildcard matches subdomains, e.g. *.vercel.app for previews.
# CLIENT_ORIGIN=https://your-app.vercel.app,*.vercel.app
# Required for a cross-site session cookie (must be paired with COOKIE_SECURE=true).
# COOKIE_SAMESITE=none
